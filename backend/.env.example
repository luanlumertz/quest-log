DATABASE_URL=""
# Opcional: conexão direta, sem -pooler, para comandos do Prisma no Render/Neon.
# Sem esta variável, o Prisma usa DATABASE_URL (desenvolvimento local e CI).
# DIRECT_URL=""
# No Render/Neon, use sslmode=verify-full na DATABASE_URL, preservando os outros parâmetros.
# Acesso direto local: 0. Em produção, configure conforme a cadeia de proxies da hospedagem.
TRUST_PROXY_HOPS=0
# Produção: mesma chave privada no Render e na Vercel (mínimo de 32 caracteres).
# ORIGIN_SECRET=""
JWT_SECRET=""
RAWG_API_KEY=""

# Desenvolvimento local: Mailpit por SMTP. Produção: EMAIL_PROVIDER=brevo.
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="QuestLog <noreply@questlog.local>"

# Somente no backend. Nunca exponha a chave em variáveis VITE_*.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="QuestLog"

PORT_LOCAL=3000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"
# Identifica a instalação: development, test, production ou sandbox.
# Sem APP_ENV, usa NODE_ENV (ou development quando ambos estiverem ausentes).
# Local: development/development; testes: test/test; produção: production/production.
# Sandbox hospedado: NODE_ENV=production e APP_ENV=sandbox.
# APP_ENV=development
# Sandbox no Render (variáveis exclusivas do novo serviço):
# NODE_ENV=production e APP_ENV=sandbox.
# DATABASE_URL e DIRECT_URL devem apontar somente para quest_log_sandbox.
# FRONTEND_URL deve ser a origem HTTPS do próprio serviço sandbox, sem /docs.
# Não configure ORIGIN_SECRET; o sandbox recebe as chamadas diretamente.
# Deixe AUTH_COOKIE_PATH_PREFIX sem definição (padrão vazio no sandbox).
# Use um JWT_SECRET exclusivo do sandbox e EMAIL_PROVIDER=brevo para e-mails reais.
# Opcional: info (padrão), warn, error, debug ou silent. Saída JSON nos logs do processo.
# LOG_LEVEL=info

# Opcional: vazio para API direta local. Em produção, o padrão é /api pela Vercel.
# AUTH_COOKIE_PATH_PREFIX=""
