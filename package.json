{
    "name": "quest-log",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "setup": "node scripts/dev.mjs setup",
        "db:prepare": "node scripts/dev.mjs db:prepare",
        "dev": "node scripts/dev.mjs dev",
        "dev:full": "node scripts/dev.mjs dev --storybook",
        "storybook": "npm run storybook --prefix frontend",
        "infra:up": "docker compose up -d --wait --wait-timeout 90",
        "infra:stop": "docker compose stop",
        "test:dev": "node --test scripts/dev.test.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "author": "Luan Lumertz",
    "license": "MIT",
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@prisma/adapter-pg": "7.10.1",
        "@types/node": "^26.6.5",
        "concurrently": "^10.0.6",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9"
    },
    "lint-staged": {
        "frontend/**/*.{js,jsx,ts,tsx}": [
            "prettier --write",
            "npm --prefix frontend exec eslint --"
        ],
        "backend/**/*.ts": [
            "prettier --write",
            "npm --prefix backend exec eslint --"
        ],
        "e2e/**/*.{ts,mts}": [
            "prettier --write"
        ],
        "playwright.config.ts": [
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
