{
  "name": "quest-log",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "author": "Luan Lumertz",
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "npm --prefix frontend exec eslint --"
    ],
    "backend/**/*.ts": [
      "prettier --write",
      "npm --prefix backend exec eslint --"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
